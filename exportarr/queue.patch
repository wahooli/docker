@@ -0,0 +1,37 @@
+package collector
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/onedr0p/exportarr/internal/arr/config"
+	"github.com/onedr0p/exportarr/internal/test_util"
+	"github.com/prometheus/client_golang/prometheus/testutil"
+	"github.com/stretchr/testify/require"
+)
+
+func TestQueueCollect_CountsAndItems(t *testing.T) {
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"page":1,"pageSize":10,"totalRecords":3,"records":[
+			{"id":1,"title":"A","sizeleft":0,"status":"completed","trackedDownloadStatus":"warning","trackedDownloadState":"importBlocked"},
+			{"id":2,"title":"B","sizeleft":1024,"status":"downloading","trackedDownloadStatus":"ok","trackedDownloadState":"downloading"},
+			{"id":3,"title":"A","sizeleft":0,"status":"completed","trackedDownloadStatus":"warning","trackedDownloadState":"importBlocked"}]}`))
+	}))
+	defer ts.Close()
+
+	collector := NewQueueCollector(&config.ArrConfig{App: "sonarr", ApiVersion: "v3", URL: ts.URL, ApiKey: test_util.API_KEY})
+	expected := strings.ReplaceAll(`# HELP sonarr_queue_total Total number of items in the queue by status, download_status, and download_state
+# TYPE sonarr_queue_total gauge
+sonarr_queue_total{download_state="downloading",download_status="ok",status="downloading",url="URL"} 1
+sonarr_queue_total{download_state="importBlocked",download_status="warning",status="completed",url="URL"} 2
+# HELP sonarr_queue_item_size_left_bytes Bytes left to download for each queue item
+# TYPE sonarr_queue_item_size_left_bytes gauge
+sonarr_queue_item_size_left_bytes{download_state="importBlocked",download_status="warning",id="1",status="completed",title="A",url="URL"} 0
+sonarr_queue_item_size_left_bytes{download_state="downloading",download_status="ok",id="2",status="downloading",title="B",url="URL"} 1024
+sonarr_queue_item_size_left_bytes{download_state="importBlocked",download_status="warning",id="3",status="completed",title="A",url="URL"} 0
+`, "URL", ts.URL)
+	require.NoError(t, testutil.CollectAndCompare(collector, strings.NewReader(expected)))
+}
